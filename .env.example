# ─────────────────────────────────────────────────────────────────────────────
# SIGA — Plantilla de variables para producción.
#
#   cp .env.example .env   &&   nano .env
#
# El archivo .env NO se versiona (.gitignore). Esta plantilla sí: es la lista
# viva de lo que docker-compose.prod.yml exige. Si el compose pide una variable
# nueva, agregarla acá en el mismo commit o el próximo despliegue falla.
#
# Todo valor marcado GENERAR se crea con openssl y no se reutiliza entre
# entornos. Los marcados PRUEBA funcionan tal cual para un demo, pero no
# protegen ni entregan nada real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio y TLS ────────────────────────────────────────────────────────────
# Sin el punto final y sin https://. Tiene que resolver a la IP de la VPS ANTES
# de levantar el stack: Caddy no puede emitir el certificado hasta entonces.
DOMAIN=siga.tudominio.com

# Let's Encrypt avisa acá si un certificado está por vencer sin renovarse.
ACME_EMAIL=tu-email@ejemplo.com

# ── Base de datos ────────────────────────────────────────────────────────────
# Postgres no se expone a internet (el servicio db no tiene "ports"), pero la
# contraseña igual protege contra cualquier otro contenedor de la misma red.
POSTGRES_DB=siga
POSTGRES_USER=siga_user
POSTGRES_PASSWORD=          # GENERAR: openssl rand -base64 24

# ── Autenticación ────────────────────────────────────────────────────────────
# Firma los JWT. Si se filtra, cualquiera puede fabricar un token de admin.
# Rotarlo invalida todas las sesiones abiertas.
JWT_SECRET=                 # GENERAR: openssl rand -base64 32

# ── Usuario administrador inicial ────────────────────────────────────────────
# Se crea en el PRIMER arranque y solo entonces. Cambiar la contraseña desde la
# app apenas entres.
#
# OJO si esto es un demo público: estas credenciales son las que le vas a dar a
# quien quiera mirar el sistema, y este usuario puede borrar todo. Ver la
# sección de datos dorados en docs/despliegue-vps.md.
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=        # GENERAR: openssl rand -base64 18

# ── Envío de correo (Resend) ─────────────────────────────────────────────────
# Recuperación de contraseña y notificaciones.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=SIGA

# PRUEBA: con onboarding@resend.dev los correos llegan SOLO a la casilla dueña
# de la API key. Para que le lleguen a un paciente real hay que verificar un
# dominio en Resend y poner acá una dirección de ese dominio.

# ── hCaptcha ─────────────────────────────────────────────────────────────────
# Protege el registro público de pacientes y el "olvidé mi contraseña".
# El login de usuarios internos no lo usa.
#
# PRUEBA: este par es el oficial de hCaptcha y SIEMPRE valida — o sea, no
# frena a ningún bot. Sirve para un demo; para el sistema real de la óptica,
# crear un sitio en hcaptcha.com y reemplazar ambos.
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
