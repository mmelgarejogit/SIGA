# ─────────────────────────────────────────────────────────────────────────────
# SIGA — Variables de entorno de PRODUCCIÓN
# Copiar a ".env" (NO se versiona) y completar. NO commitear el .env real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio y HTTPS (Caddy / Let's Encrypt) ──────────────────────────────────
# El dominio debe tener un registro A apuntando a la IP pública de la VPS.
DOMAIN=siga.tudominio.com
ACME_EMAIL=mathias99gaona@gmail.com

# ── Base de datos (Postgres en Docker) ───────────────────────────────────────
POSTGRES_DB=siga
POSTGRES_USER=siga_user
# Generar fuerte:  openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAME_password_db_fuerte

# ── JWT — generar uno NUEVO, no reusar el de desarrollo ──────────────────────
# Generar:  openssl rand -base64 32
JWT_SECRET=CAMBIAME_jwt_secret_de_32_bytes

# ── Usuario administrador inicial (primer login) ─────────────────────────────
# Se crea automáticamente al primer arranque. CAMBIAR la contraseña tras entrar.
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=CAMBIAME_password_admin_fuerte

# ── Resend (envío de emails: verificación, reset de contraseña) ──────────────
# Para que los emails salgan a destinatarios reales hace falta un dominio
# verificado en Resend; con onboarding@resend.dev solo se envía a tu propio mail.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=SIGA-Optica

# ── hCaptcha (solo registro público de pacientes; el login NO lo usa) ─────────
# Site-key se hornea en el build del front; secret-key la valida el backend.
# Los valores de abajo son las claves de PRUEBA (siempre pasan). Para captcha
# real, crear un sitio en hCaptcha y reemplazar ambas.
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
